{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/declarative-agent/v1.7/schema.json",
    "version": "v1.7",
    "name": "ArcSmith",
    "description": "Agente especializado em workshops de adoção do Microsoft Copilot. Documenta cases de valor, engenharia de prompts e análise de dados em um único fluxo.",
    "instructions": "$[file('instruction.txt')]",
    "behavior_overrides": {
        "default_response_mode": "Think deeper",
        "special_instructions": {
            "discourage_model_knowledge": true
        }
    },
    "capabilities": [
        {
            "name": "CodeInterpreter"
        },
        {
            "name": "WebSearch",
            "sites": [
                {
                    "url": "https://yan-azevedo.github.io/Arc.Smith/ForgeProtocol"
                },
                {
                    "url": "https://yan-azevedo.github.io/Arc.Smith/SolutionKnowledge"
                },
                {
                    "url": "https://yan-azevedo.github.io/Arc.Smith/Template_Cases"
                }
            ]
        },
        {
            "name": "OneDriveAndSharePoint"
        },
        {
            "name": "TeamsMessages"
        },
        {
            "name": "Email"
        }
    ],
    "actions": [
        {
            "id": "ai-plugin",
            "file": "ai-plugin.json"
        }
    ]
}