{
    "$schema": "https://developer.microsoft.com/json-schemas/copilot/declarative-agent/v1.9/schema.json",
    "version": "v1.9",
    "name": "ArcSmith",
    "description": "Agente para desenvolvimento estruturado de soluções de IA no ecossistema Microsoft Copilot: documenta e prioriza cases a partir de reuniões, cria instruções de agentes com engenharia de prompt, orienta a criação no Copilot Chat, Agent Builder, Agents Toolkit, Copilot Studio e Copilot Notebooks, e gera a documentação de entrega.",
    "instructions": "$[file('instruction.txt')]",
    "behavior_overrides": {
        "default_response_mode": "Think deeper",
        "special_instructions": {
            "discourage_model_knowledge": true
        }
    },
    "capabilities": [
        {
            "name": "CodeInterpreter"
        },
        {
            "name": "OneDriveAndSharePoint"
        },
        {
            "name": "TeamsMessages"
        },
        {
            "name": "Email"
        },
        {
            "name": "EmailActions"
        }
    ],
    "actions": [
        {
            "id": "ai-plugin",
            "file": "ai-plugin.json"
        }
    ],
    "agent_skills": [
        {
            "folder": "skills/arc-cases"
        },
        {
            "folder": "skills/smith-prompt"
        },
        {
            "folder": "skills/copilot-chat"
        },
        {
            "folder": "skills/copilot-m365-agent-builder"
        },
        {
            "folder": "skills/copilot-m365-toolkit"
        },
        {
            "folder": "skills/copilot-studio"
        },
        {
            "folder": "skills/copilot-notebooks"
        },
        {
            "folder": "skills/documentacao"
        }
    ]
}